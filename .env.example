# Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).
# See docs/PROJECT.md -> "Setup" for how to obtain each value.

# --- Runtime ---
ARB_ENVIRONMENT=demo            # demo | prod  (always develop against demo first)
ARB_DB_PATH=data/arb.sqlite

# --- Live trading MASTER SWITCH (Phase 4) ---
# Real orders require ALL of: this = true, execution.mode = semi_auto|auto (config.yaml),
# and ARB_ENVIRONMENT = prod. Leave false for paper-trading (the safe default).
ARB_LIVE_TRADING=false

# --- Telegram notifications (see docs/PROJECT.md -> "Step: Telegram bot setup") ---
ARB_TELEGRAM_BOT_TOKEN=
ARB_TELEGRAM_CHAT_ID=

# --- Kalshi API (RSA key auth). Only needed for authenticated calls / Phase 4. ---
# Public market data & the demo environment work without these for early phases.
ARB_KALSHI_API_KEY_ID=
ARB_KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# --- Polymarket (Phase 4 execution only; v1 uses public read-only endpoints) ---
ARB_POLYMARKET_PRIVATE_KEY=
